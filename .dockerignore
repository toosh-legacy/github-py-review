# The API image only needs the service packages under src/. Everything below is
# dev/train/UI surface that would bloat the image (and its build cache).
.git
.github
.venv
_archive
docs
tests
deploy
**/__pycache__
*.sqlite3
src/ml
src/apps
# The image has no Node runtime, so the eslint install would be dead weight —
# the JS detector degrades to its pattern rules and reports that it did.
src/security/eslint/node_modules
