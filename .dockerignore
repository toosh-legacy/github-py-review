# The API image only needs the service packages under src/. Everything below is
# dev/train/UI surface that would bloat the image (and its build cache).
.git
.github
.venv
_archive
docs
tests
deploy
**/__pycache__
*.sqlite3
src/ml
src/apps
# The image builds its own node_modules from package.json in a Node stage, so
# the host's copy must not be shipped in: it may have been built for a different
# platform, and it would bust the layer cache on every change.
src/security/eslint/node_modules
