{
  "manifest_version": 3,
  "name": "Repo Security Scanner",
  "version": "0.3.0",
  "description": "Scan a GitHub repository for exposed secrets, vulnerable dependencies, and unsafe code patterns — detected by real tools, triaged by an LLM.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:8001/*",
    "https://github.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Repo Security Scanner"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/pull/*"],
      "js": ["content_script.js"]
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["security_script.js"]
    }
  ]
}
