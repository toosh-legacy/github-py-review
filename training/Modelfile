# Ollama Modelfile for the fine-tuned local reviewer.
#
# export_to_gguf.py rewrites the FROM line to point at the quantized GGUF it
# produces. Then register it with Ollama and serve on CPU:
#
#   ollama create codereview-qwen -f training/Modelfile
#   # .env:  LLM_BACKEND=local  LOCAL_LLM_MODEL=codereview-qwen
#
# The backend sends its own system prompt per request (llm_model/prompts.py), so
# no SYSTEM line is needed here. temperature 0 keeps reviews reproducible.
FROM ./merged/codereview-qwen-Q4_K_M.gguf
PARAMETER temperature 0
PARAMETER num_ctx 4096
