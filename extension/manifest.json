{
  "manifest_version": 3,
  "name": "AI Code Review Copilot",
  "version": "0.2.0",
  "description": "Review a GitHub PR, or scan a repo and debug a single file, with the AI Code Review Copilot backend.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:8001/*",
    "https://github.com/*",
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Code Review Copilot"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/pull/*"],
      "js": ["content_script.js"]
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["repo_script.js"]
    }
  ]
}
