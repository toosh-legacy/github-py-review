# Copy this somewhere outside the repositories you scan, fill it in, and point
# REPOSEC_ENV_FILE at it:
#
#     export REPOSEC_ENV_FILE=~/.config/reposec/env
#
# The file is read only when that variable names it. A scanned repository is
# untrusted input, and a `.env` picked up from the working directory would let
# the repository being scanned choose the backend its own scan runs against.
#
# Every value is optional, and plain environment variables work just as well.
# Nothing here is required for the scanner to work: detection is deterministic
# (secret rules, OSV, bandit, eslint-plugin-security) and a model only affects
# triage — the deduplication, ranking, explanation and fix.

# --- Which backend triage uses: auto | local | openai | mock ---
# "auto" prefers a local model, then OpenAI, then none.
# "mock" means no model: detection runs, triage is skipped.
LLM_BACKEND=auto

# --- Local LLM: any OpenAI-compatible server. Nothing leaves the machine. ---
# Ollama:     http://localhost:11434/v1
# llama.cpp / vLLM / LM Studio also work.
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# On CPU-only machines use a small model — qwen2.5-coder:3b (or :1.5b for
# speed). The 7b default assumes a GPU; it runs on CPU but is slow.
LOCAL_LLM_MODEL=qwen2.5-coder:3b

# --- Hosted OpenAI ---
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-codex

# --- Security scanner -------------------------------------------------------
# Turn the LLM stage off entirely. The scan still works and ships the
# rule-authored explanations instead of model-written ones.
SECURITY_TRIAGE=true
# Skip the OSV lookup (air-gapped runs). The dependency detector then reports
# itself as degraded rather than returning a false all-clear.
SECURITY_OFFLINE=false
