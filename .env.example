# Copy to .env and fill in. Every value is optional — with none of them set the
# app runs in mock mode: no keys, no network, SQLite on disk.

# --- Which reviewer to use: auto | local | openai | mock ---
# "auto" prefers a local model, then OpenAI, then the mock.
LLM_BACKEND=local

# --- Local LLM: any OpenAI-compatible server. Nothing leaves the machine. ---
# Ollama:     http://localhost:11434/v1
# llama.cpp / vLLM / LM Studio also work.
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# On CPU-only machines use a small model — qwen2.5-coder:3b (or :1.5b for
# speed). The 7b default assumes a GPU; it runs on CPU but is slow.
LOCAL_LLM_MODEL=qwen2.5-coder:3b

# --- Hosted OpenAI ---
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-codex

# --- Precision controls (small models over-report; these are the levers) ---
# Second LLM pass that must confirm each candidate issue before it ships.
VERIFY_FINDINGS=true
# Drop anything below this severity from the final report: high | medium | low
MIN_SEVERITY=low

# --- GitHub: read scope to fetch diffs; write scope only for post-comment ---
# GITHUB_TOKEN=ghp_...

# --- Database. Local default is SQLite; docker-compose sets Postgres. ---
# DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/reviewdb
DATABASE_URL=sqlite:///./reviewdb.sqlite3

# --- CORS: who may call the API (Streamlit app + GitHub) ---
ALLOWED_ORIGINS=http://localhost:8501,https://github.com

# --- Guardrails against oversized PRs ---
MAX_DIFF_BYTES=200000
MAX_FILES=50
